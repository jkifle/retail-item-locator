# EXAMPLE - Copy to .env and fill in your values
# DO NOT COMMIT .env FILE TO GIT

DATABASE_URL=postgresql://user:password@localhost:5432/retail_locator
LOG_LEVEL=INFO
FLASK_ENV=development

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://retail-item-locator.onrender.com,http://localhost:5173,http://localhost:3000

# Firebase Admin verification.
# Use GOOGLE_APPLICATION_CREDENTIALS in hosting if possible. For hosts that only
# support environment secrets, set FIREBASE_CREDENTIALS_JSON to the service
# account JSON on one line.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_JSON=

# Service-to-service import clients must now be looked up in the database:
# clients.api_key -> clients.id as client_id.
# There is intentionally no global API_KEY fallback.
